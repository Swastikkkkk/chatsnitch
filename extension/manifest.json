{
  "manifest_version": 3,
  "name": "ChatSnitch: who can read your AI chats",
  "short_name": "ChatSnitch",
  "version": "0.2.0",
  "description": "See which of your extensions can read ChatGPT, Claude, Gemini and other AI chats. Runs locally, no network access.",
  "permissions": ["management"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatSnitch",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
